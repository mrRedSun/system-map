{
  "name": "system-map",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive, read-only map of a self-hosted server, rendered from YAML",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "DATA_DIR=${DATA_DIR:-examples} PORT=${PORT:-8787} tsx watch src/server/main.ts",
    "dev:web": "vite --config vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config vite.config.ts",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist/server.mjs",
    "demo": "tsx scripts/demo.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "schema": "tsx scripts/gen-schema.ts",
    "schema:check": "tsx scripts/gen-schema.ts --check",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "validate": "tsx src/server/validate-cli.ts"
  },
  "dependencies": {
    "@effect/atom-react": "4.1.5",
    "@effect/platform-browser": "4.1.5",
    "@effect/platform-node": "4.1.5",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@xyflow/react": "13.0.2",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "effect": "4.1.4",
    "elkjs": "0.12.1",
    "get-nonce": "1.0.1",
    "lucide-react": "1.78.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tw-animate-css": "1.4.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.5",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "concurrently": "10.0.7",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
