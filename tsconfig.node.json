{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/web/*"]
    }
  },
  "include": [
    "src/server",
    "src/shared",
    "scripts",
    "test",
    "vite.config.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ]
}
